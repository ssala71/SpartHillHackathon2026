APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg://username:password@host:5432/database_name
AWS_REGION=us-east-1
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
# gazetteer = offline simulated San Jose landmarks; aws_location = Amazon Location Service
GEOCODING_PROVIDER=gazetteer

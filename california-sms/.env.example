# =============================================================================
# Local environment template for actual AWS operation
#
# Copy to .env only when that file does not already exist, then fill in real values.
# Keep .env untracked. AWS credentials come from your authenticated CLI profile;
# this template contains no access keys. Deployment uses template.yaml variables
# instead and packages no .env file. Configuration is cached, so restart the local
# server after edits. There is no demo mode: successful sends incur AWS charges.
# =============================================================================
# All sends and replies use AWS. Fill every required field before starting.
# AWS_PROFILE applies locally; Lambda uses its execution role.
AWS_PROFILE=hackathon
AWS_REGION=us-west-2
# The SNS topic and SMS origination ARN must belong to this same region.
# Set the deployed stack's ApiTokenSecretArn, or a random API_TOKEN of 32+ characters.
# The secret ARN takes precedence. Keep the token server-side.
API_TOKEN_SECRET_ARN=
API_TOKEN=
# Comma-separated E.164 numbers whose owners consented to receive messages.
ALLOWED_RECIPIENTS=
# Your approved dedicated number in E.164 format, followed by its full AWS ARN.
SMS_PHONE_NUMBER=
SMS_ORIGINATION_ID=
# This inference profile can route within the US. Keep its ID aligned with the
# Bedrock resources allowed by the Lambda execution role in template.yaml.
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Stack outputs: LedgerTable and InboundTopicArn.
TABLE_NAME=
INBOUND_TOPIC_ARN=
# Counts attempts across API sends and AI replies; failures may also consume quota.
DAILY_LIMIT_PER_RECIPIENT=20
# Maximum accepted message-part price, not a total account or daily spending limit.
SMS_MAX_PRICE_USD=0.05
